# 1. LLM API CONFIGURATION
LLM_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT="60"
LLM_MAX_RETRIES="2"

# 2. DISTRIBUTED DATABASE & CACHE (Redis)
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL="rediss://default:your_upstash_password@your-redis-name.upstash.io:6379"

# 3. VECTOR DB & RAG CONFIGURATION
# Local directory path for ChromaDB storage
CHROMA_DB_PATH="./chroma_db"
# Local sentence-transformers model used for RAG embeddings (downloaded on first use)
LOCAL_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# Optional: Qdrant collection for these local embeddings; do not reuse the old OpenAI-vector collection
QDRANT_COLLECTION="oxalis_blueprints_local"

# 4. SERVICE NETWORKING & ENDPOINTS
# Local development: http://127.0.0.1:8000
# Production on Render: https://your-backend-service.onrender.com
OXALIS_BACKEND_URL="http://127.0.0.1:8000"

# Port assignments (Optional for local container runtime)
BACKEND_PORT=8000
FRONTEND_PORT=8501